# Twilio credentials — from console.twilio.com dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Sender — must belong to a Verified Sender domain in the Twilio console
FROM_ADDRESS=demo@yourdomain.com
FROM_NAME=Twilio Email Demo

# SMS-capable Twilio number that attendees text their email addresses to (E.164)
TWILIO_PHONE_NUMBER=+15005550006

